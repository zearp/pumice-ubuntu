search ${search_params}
set default=${default_boot}
if [ -n "$$extra_cmdline" ]; then
  submenu "Bootable snapshot $$snapshot_num" {
    menuentry "If OK, run snapper rollback and reboot." { true; }
  }
fi
if [ -n "$${iso_path}" ]; then
    isoboot="iso-scan/filename=$${iso_path}"
fi
set timeout=${boot_timeout}
set timeout_style=${boot_timeout_style}
function load_video {
    if [ "$${grub_platform}" = "efi" ]; then
        insmod efi_gop
    else
        insmod efi_gop
        insmod vbe
        insmod vga
        insmod video_bochs
        insmod video_cirrus
    fi
}
insmod part_gpt
insmod ext2
insmod gzio
if loadfont unicode ; then
    set gfxmode=${gfxmode}
    load_video
    insmod gfxterm
fi
terminal_input ${terminal_input}
terminal_output ${terminal_output}
menuentry "${title} (normal)" --class os --unrestricted {
    load_video
    set gfxpayload=keep
    echo Loading kernel...
    linux ($$root)${bootpath}/${kernel_file} $${extra_cmdline} $${isoboot} ${boot_options}
    echo Loading initrd...
    initrd ($$root)${bootpath}/${initrd_file}
}
menuentry "${title} (failsafe)" --class os --unrestricted {
    load_video
    set gfxpayload=keep
    echo Loading kernel...
    linux ($$root)${bootpath}/${kernel_file} $${extra_cmdline} $${isoboot} ${failsafe_boot_options}
    echo Loading initrd...
    initrd ($$root)${bootpath}/${initrd_file}
}
menuentry "Boot from internal disk" --class os --unrestricted {
    exit
}
if [ -f "/.snapshots/grub-snapshot.cfg" ]; then
    source "/.snapshots/grub-snapshot.cfg"
fi
