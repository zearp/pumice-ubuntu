dash-max-icon-size=42
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
hot-keys=false
intellihide=true
intellihide-mode='FOCUS_APPLICATION_WINDOWS'
show-apps-at-top=true
show-mounts=false
show-mounts-network=false

[org/gnome/shell/extensions/ding]
