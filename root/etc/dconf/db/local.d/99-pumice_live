# disables auto screen lock sleep, preventing locking out the user when
# the installer is not running, user can not unlock as no password is set
# (this file will be automatically removed upon first boot)
#
[org/gnome/desktop/screensaver]
lock-enabled=false

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
