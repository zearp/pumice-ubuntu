#!/bin/sh
#
# reverts pumice_keyd_enable: stops keyd and masks it again
#
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "pumice_keyd_disable: must be run as root (sudo)" >&2
    exit 1
fi

systemctl disable --now keyd.service 2>/dev/null || true
systemctl mask keyd.service

echo "keyd disabled and masked again"
