#!/bin/sh
#
# changes initial brightness to 50% on supported devices
# some laptops/screens default to 100% which is too bright
# only runs once per device (marker file in /var/lib/pumice)
# it will not override brightness the user sets themselves
#
set -eu

name="$1"
backlight="/sys/class/backlight/${name}"
marker="/var/lib/pumice/backlight-defaulted-${name}"

[ -d "${backlight}" ] || exit 0
[ -f "${marker}" ] && exit 0

max=$(cat "${backlight}/max_brightness")
half=$((max / 2))

echo "${half}" > "${backlight}/brightness" 2>/dev/null || exit 0

mkdir -p /var/lib/pumice
touch "${marker}"

exit 0
