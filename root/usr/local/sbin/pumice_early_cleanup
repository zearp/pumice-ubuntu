#!/bin/bash
#
# removed left overs, only runs on installed systems
# in order to prevent a race condition some files are
# deleted in both clean up scripts, this is required
# (this file will be automatically removed upon first boot)
#
set -euo pipefail

log() { echo "pumice_early_cleanup: $*" | systemd-cat -t pumice_early_cleanup; }

root_fstype=$(findmnt -no FSTYPE / || echo unknown)

if [ "${root_fstype}" = "overlay" ]; then
    log "root is an overlay (live session) - nothing to do, installer autostart and OOBE mask both stay."
    exit 0
fi

log "root is ${root_fstype} (installed system) - removing installer autostart + gnome-initial-setup mask before any session can read them, then self-deleting."
rm -f /etc/xdg/autostart/ubuntu-desktop-bootstrap.desktop
rm -f /usr/local/bin/pumice_launch_installer
rm -f /etc/systemd/user/gnome-initial-setup-first-login.service
rm -f /usr/local/sbin/pumice_early_cleanup

exit 0
